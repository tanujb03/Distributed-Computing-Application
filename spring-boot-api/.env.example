# Copy to .env for local Spring Boot execution; never commit credentials.
POSTGRES_DB=distributed_computing
POSTGRES_USER=distributed_app
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
SERVER_PORT=18080
# Optional public API origin allowlist, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local development only. Set true and provide a random token for any public deployment.
DEMO_CONTROL_ENFORCE=false
DEMO_CONTROL_TOKEN=
# Deployment runtime options; keep local defaults as Docker Compose.
EXPERIMENT9_LAUNCHER=docker
EXPERIMENT10_LAUNCHER=docker
EXPERIMENT7_SPARK_MASTER=local[2]
EXPERIMENT7_SPARK_PARTITIONS=2
EXPERIMENT9_RANKS=4
EXPERIMENT10_RANKS=4
EXPERIMENT10_DEFAULT_MATRIX_SIZE=200
